@page "/product/{Id}"
@using BlazorSampleCommerce.DTOs
@using System.Globalization
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>@(product?.Name ?? "Loading...") - Details</PageTitle>

<div class="container mt-5">
    @if (product == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Loading product details...</p>
        </div>
    }
    else
    {
        <div class="row">
            @* Left Column: Images Placeholder *@
            <div class="col-md-6">
                <div class="bg-light d-flex align-items-center justify-content-center shadow-sm mb-3"
                     style="height: 400px; border-radius: 10px; border: 2px dashed #ccc;">
                    <div class="text-center">
                        <i class="bi bi-image" style="font-size: 4rem; color: #ccc;"></i>
                        <p class="text-muted">Image Placeholder (V2 API)</p>
                    </div>
                </div>
                
                <button class="btn btn-success btn-lg w-100 shadow" @onclick="AddToCart">
                    <i class="bi bi-cart-plus"></i> Aggiungi al carrello
                </button>
            </div>

            @* Right Column: Info and SKU selection *@
            <div class="col-md-6">
                <h1 class="display-5 fw-bold">@product.Name</h1>
                <p class="text-muted">Brand: <strong>@product.Brand</strong></p>

                <div class="mb-4">
                    <label class="form-label d-block text-uppercase fw-bold" style="font-size: 0.8rem;">Variazioni:</label>
                    <div class="btn-group" role="group">
                        @foreach (var sku in product.StockKeepingUnits)
                        {
                            var firstFeature = sku.Features.FirstOrDefault();
                            <button type="button"
                                    class="btn @(selectedSku?.Id == sku.Id ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => SelectSku(sku)">
                                @(firstFeature.Value ?? "Standard")
                            </button>
                        }
                    </div>
                </div>

                <h2 class="text-success mb-3">@selectedSku?.Price.ToString("C", CultureInfo.GetCultureInfo("en-US"))</h2>
                
                <div class="card mb-4 bg-light border-0">
                    <div class="card-body">
                        <p class="card-text">@product.Description</p>
                    </div>
                </div>

                @* Dropdown Controlado pelo Blazor *@
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle w-100 text-start"
                            type="button"
                            @onclick="ToggleDropdown">
                        Specifiche Tecniche
                    </button>
                    <ul class="dropdown-menu w-100 p-3 @(isDropdownOpen ? "show" : "")"
                        style="display: @(isDropdownOpen ? "block" : "none"); position: relative;">
                        @if (selectedSku != null)
                        {
                            @foreach (var feature in selectedSku.Features)
                            {
                                <li class="d-flex justify-content-between border-bottom py-1">
                                    <span class="fw-bold">@feature.Key:</span>
                                    <span>@feature.Value</span>
                                </li>
                            }
                            <li class="d-flex justify-content-between py-1 mt-2 text-info">
                                <span class="fw-bold">Stock Disponibile:</span>
                                <span>@selectedSku.Stock units</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        @* Reviews Section *@
        <div class="row mt-5">
            <div class="col-12">
                <hr />
                <h3>Recensioni dei clienti</h3>
                
                @* Formulário para novo comentário *@
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Lascia una recensione</h5>
                        <div class="mb-3">
                            <label class="form-label">Valutazione (1-5)</label>
                            <select class="form-select" @bind="newReviewRate">
                                <option value="5">5 - Eccellente</option>
                                <option value="4">4 - Molto buono</option>
                                <option value="3">3 - Buono</option>
                                <option value="2">2 - Scarso</option>
                                <option value="1">1 - Pessimo</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Commento</label>
                            <textarea class="form-control" rows="3"
                                      placeholder="Cosa ne pensi di questo prodotto?"
                                      @bind="newReviewComment"></textarea>
                        </div>
                        <button class="btn btn-primary" @onclick="SubmitReview">Invia Recensione</button>
                    </div>
                </div>

                @* Lista de Reviews (Atualmente vazia) *@
                <div class="alert alert-light border shadow-sm">
                    Non ci sono ancora recensioni per questo prodotto. Sii il primo a recensire!
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = "";
    private ProductDto? product;
    private SkuDto? selectedSku;

    // Estados de UI
    private bool isDropdownOpen = false;
    private int newReviewRate = 5;
    private string newReviewComment = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            product = await Http.GetFromJsonAsync<ProductDto>($"Products/{Id}");
            
            if (product?.StockKeepingUnits != null && product.StockKeepingUnits.Any())
            {
                selectedSku = product.StockKeepingUnits.First();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void ToggleDropdown() => isDropdownOpen = !isDropdownOpen;

    private void SelectSku(SkuDto sku)
    {
        selectedSku = sku;
        isDropdownOpen = false; // Fecha o dropdown ao trocar SKU para forçar o usuário a abrir e ver os novos dados
    }

    private void AddToCart()
    {
        Console.WriteLine($"Added SKU {selectedSku?.Id} to cart.");
    }

    private void SubmitReview()
    {
        // Aqui ficará a lógica que você me passará depois
        Console.WriteLine($"Review enviada: Nota {newReviewRate}, Comentário: {newReviewComment}");
        
        // Limpa os campos após o envio
        newReviewComment = "";
        newReviewRate = 5;
    }
}